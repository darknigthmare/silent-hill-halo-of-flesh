  "inclusionPolicy": {
    "included": "Œuvres narratives distinctes, jeux publiés, scénarios et éditions significatives, films individualisés, annonces explicites, projets annulés documentés, communications officielles utiles, supports documentaires majeurs et collaborations/machines identifiées.",
    "grouped": [
      "Ports identiques et éditions régionales sans œuvre nouvelle.",
      "Recueils Three Bloody Tales et Omnibus reliés aux récits qu’ils contiennent.",
      "Skins et costumes des crossovers regroupés avec le jeu hôte.",
      "Programmes Transmission et PRESS START regroupés par série avec les épisodes utiles comme preuves."
    ],
    "excluded": [
      "Catalogue exhaustif des OST, rééditions musicales et marchandises.",
      "Chaque guide commercial ou ouvrage critique indépendant.",
      "Rumeurs et pitches sans confirmation suffisante.",
      "Fanworks ou publications dont la licence n’est pas établie ; par exemple aucune qualification officielle de Silent Hill: Betrayal n’est inférée.",
      "Ajout de personnages, de scènes, de capacités ou de chronologie canonique depuis une simple notice bibliographique."
    ],
    "completenessClaim": "Couverture documentée du périmètre convenu ; aucune promesse d’exhaustivité mondiale de tous les produits dérivés."
  },
